LLM_PROVIDER=codex
CODEX_MODE=workspace
DATA_SOURCE=csv
STOCK_FILE=data/mock/stock.csv
ORDERS_FILE=data/mock/purchase_orders.csv
CONSUMPTION_FILE=data/mock/consumption.csv
HOMOLOGATION_FILE=data/mock/homologation.csv
LEAD_TIME_DAYS=7
SAFETY_BUFFER_DAYS=7
SPIKE_MULTIPLIER=1.25
PRICE_DEVIATION_PCT=0.03
OVERSTOCK_RATIO=2.5
OVERSTOCK_DAYS=180

# Optional: email agent via IMAP. Use an app password/OAuth relay when your provider requires it.
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SSL=true
EMAIL_USERNAME=usuario@example.com
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX

# Recommended for Outlook.com / Microsoft 365: Microsoft Graph OAuth.
# Personal Outlook/Hotmail: MSGRAPH_TENANT_ID=consumers
# Corporate Microsoft 365: use your tenant id, or common/organizations if allowed.
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=consumers
MSGRAPH_FOLDER=inbox
MSGRAPH_SCOPES=Mail.Read User.Read
MSGRAPH_TOKEN_CACHE=.msal_token_cache.json
